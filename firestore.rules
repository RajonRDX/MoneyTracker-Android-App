rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function hasAuditFields() {
      return request.resource.data.keys().hasAll(['id', 'createdAt', 'updatedAt'])
             && request.resource.data.id is string
             && request.resource.data.createdAt is int
             && request.resource.data.updatedAt is int;
    }
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /settings/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && hasAuditFields();
      }
      match /months/{yearMonth} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && hasAuditFields() && request.resource.data.yearMonth is string;
      }
      match /monthlySummaries/{yearMonth} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && hasAuditFields() && request.resource.data.yearMonth is string;
      }
      match /categories/{catId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasAuditFields() && request.resource.data.name is string;
        allow delete: if isOwner(uid);
      }
      match /transactions/{txId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasAuditFields() && request.resource.data.amount is number && request.resource.data.yearMonth is string;
        allow delete: if isOwner(uid);
      }
      match /recurring/{recId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasAuditFields() && request.resource.data.name is string;
        allow delete: if isOwner(uid);
      }
      match /budgets/{budgetId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasAuditFields() && request.resource.data.limitAmount is number;
        allow delete: if isOwner(uid);
      }
      match /goals/{goalId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasAuditFields() && request.resource.data.name is string;
        allow delete: if isOwner(uid);
        match /deposits/{depId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid) && hasAuditFields() && request.resource.data.amount is number;
          allow delete: if isOwner(uid);
        }
      }
      match /debts/{debtId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasAuditFields() && request.resource.data.personName is string;
        allow delete: if isOwner(uid);
        match /payments/{payId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid) && hasAuditFields() && request.resource.data.amount is number;
          allow delete: if isOwner(uid);
        }
      }
    }
  }
}
